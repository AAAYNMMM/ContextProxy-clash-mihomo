{
  "manifest_version": 3,
  "name": "ContextProxy Reporter",
  "version": "0.1.0",
  "description": "Report tabHost and requestHost to the local ContextProxy core service.",
  "permissions": [
    "webRequest",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
